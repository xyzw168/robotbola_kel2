<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="stm32_mecanum_robot">
  <xacro:arg name="device" default="/dev/ttyACM0"/>
  <xacro:arg name="baud_rate" default="115200"/>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="front_left_wheel_link"/>
  <link name="front_right_wheel_link"/>
  <link name="rear_left_wheel_link"/>
  <link name="rear_right_wheel_link"/>
  <link name="gripper_link"/>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel_link"/>
    <origin xyz="0.15 0.15 0.0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel_link"/>
    <origin xyz="0.15 -0.15 0.0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel_link"/>
    <origin xyz="-0.15 0.15 0.0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel_link"/>
    <origin xyz="-0.15 -0.15 0.0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="gripper_joint" type="revolute">
    <parent link="base_link"/><child link="gripper_link"/>
    <origin xyz="0.20 0.0 0.10" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="0.0" upper="3.141592653589793" effort="10.0" velocity="2.0"/>
  </joint>

  <ros2_control name="STM32RobotSystem" type="system">
    <hardware>
      <plugin>stm32_ros2_control_hardware/STM32System</plugin>
      <param name="device">$(arg device)</param>
      <param name="baud_rate">$(arg baud_rate)</param>
      <param name="wheel_joint_names">front_left_wheel_joint,front_right_wheel_joint,rear_left_wheel_joint,rear_right_wheel_joint</param>
      <param name="gripper_joint_name">gripper_joint</param>
      <param name="require_feedback">false</param>
      <param name="feedback_timeout_ms">1000</param>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="gripper_joint">
      <command_interface name="position">
        <param name="min">0.0</param><param name="max">3.141592653589793</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </ros2_control>
</robot>
